# Copy this file to `.env` and adjust if needed.
#
# WXT exposes variables prefixed with WXT_ to the extension at build time via
# `import.meta.env`. See:
# https://wxt.dev/guide/essentials/config/environment-variables.html
#
# Phoenix Channels socket URL of the backend (backs_backs_backs). Read in
# utils/tab-sync.ts; if unset/empty it falls back to ws://localhost:4000/socket.
#   - Local dev: ws://localhost:4000/socket
#   - Production (TLS terminated upstream): wss://your-domain.example/socket
WXT_SYNC_SOCKET_URL=ws://localhost:4000/socket

# NOTE: the OpenRouter API key is NOT configured here — it is entered in the
# extension popup and stored in browser.storage.local (see utils/settings.ts).
